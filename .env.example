# OpenAI / LLM Credentials
API_KEY=your_openai_or_compatible_api_key
BASE_URL=https://api.openai.com/v1

# Neo4j Graph DB Credentials
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_aura_instance_id
AURA_INSTANCENAME=your_aura_instance_name

# Pinecone Vector DB Credentials
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index_name

# Optional Vector Settings
EMBEDDING_MODEL=text-embedding-3-small

# Sarvam AI Credentials (for speech-to-text audio & video transcription)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v4

# Optional FFmpeg Path overrides (auto-detected via ffmpeg-static & ffprobe-static if omitted)
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFPROBE_PATH=C:/path/to/ffprobe.exe
